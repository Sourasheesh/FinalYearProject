# SMTP Email Configuration (Gmail)
# Backend auto-detects SMTP when EMAIL_HOST_USER/PASSWORD are set.
# 
# IMPORTANT: If 2FA is enabled on your Gmail account (recommended),
# you MUST use an App Password, NOT your regular password.
# Generate one at: https://myaccount.google.com/apppasswords
# Select "Mail" and your device, then copy the 16-character password.
#
# If 2FA is NOT enabled, enable "Less secure app access" or use
# https://accounts.google.com/DisplayUnlockCaptcha

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
